// 이걸주네? AI 맞춤형 선물 추천 서비스
// PostgreSQL / MVP 8-table schema
// 기준: 2026-09-03 최신 DB 설계 및 일반 이메일 로그인 확정

Table users {
  user_id bigint [pk, increment]
  email varchar(255) [not null, unique, note: '로그인 식별자. 소문자 정규화 후 저장']
  password_hash varchar(255) [not null, note: '평문 저장 금지. BCrypt 또는 Argon2 해시']
  name varchar(100) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `char_length(btrim(email)) > 3` [name: 'chk_users_email_not_blank']
    `char_length(btrim(name)) > 0` [name: 'chk_users_name_not_blank']
  }

  Note: 'UC1 / REQ-F-001. 일반 이메일 회원가입·로그인 사용자'
}

Table recipient {
  recipient_id bigint [pk, increment]
  user_id bigint [not null]
  name varchar(100) [not null, note: '이름 또는 별명']
  relationship varchar(50) [not null]
  age_group varchar(30) [not null]
  gender varchar(20) [not null]
  job varchar(100)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id [name: 'idx_recipient_user_id']
  }

  checks {
    `char_length(btrim(name)) > 0` [name: 'chk_recipient_name_not_blank']
  }

  Note: 'UC2 / REQ-F-002. 사용자가 직접 관리하는 비공개 선물 대상'
}

Table structured_preference {
  preference_id bigint [pk, increment]
  recipient_id bigint [not null]
  preference_type varchar(50) [not null, note: 'INTEREST, PREFERRED_CATEGORY, PREFERRED_ATTRIBUTE, DISLIKED_CATEGORY, WISH_ITEM']
  preference_value varchar(255) [not null]
  source_type varchar(20) [not null, note: 'DIRECT, KAKAO']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    recipient_id [name: 'idx_structured_preference_recipient_id']
    (recipient_id, preference_type, preference_value) [unique, name: 'uq_recipient_preference']
  }


  checks {
    `preference_type in ('INTEREST', 'PREFERRED_CATEGORY', 'PREFERRED_ATTRIBUTE', 'DISLIKED_CATEGORY', 'WISH_ITEM')` [name: 'chk_preference_type']
    `source_type in ('DIRECT', 'KAKAO')` [name: 'chk_preference_source']
    `char_length(btrim(preference_value)) > 0` [name: 'chk_preference_value_not_blank']
  }

  Note: 'UC3·UC5·UC6·UC7 / REQ-F-003·005·006·007. 직접 입력 또는 카카오 분석 후 사용자가 승인한 취향만 저장'
}

Table previous_gifts {
  previous_gift_id bigint [pk, increment]
  recipient_id bigint [not null]
  gift_name varchar(255) [not null]
  gift_category varchar(100)
  gifted_at date
  note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    recipient_id [name: 'idx_previous_gifts_recipient_id']
  }


  checks {
    `char_length(btrim(gift_name)) > 0` [name: 'chk_previous_gift_name_not_blank']
  }

  Note: 'UC11 / REQ-F-011. 대상에게 과거에 준 선물. 추천 후보 선택 이력과는 별개'
}

Table gift_conditions {
  condition_id bigint [pk, increment]
  recipient_id bigint [not null]
  budget_min integer [not null]
  budget_max integer [not null]
  occasion_type varchar(100) [not null]
  occasion_date date
  preference_note text
  avoid_gift_note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    recipient_id [name: 'idx_gift_conditions_recipient_id']
  }

  checks {
    `budget_min >= 0` [name: 'chk_gift_conditions_budget_min']
    `budget_max >= budget_min` [name: 'chk_gift_conditions_budget_range']
    `char_length(btrim(occasion_type)) > 0` [name: 'chk_gift_conditions_occasion_not_blank']
  }

  Note: 'UC3·UC7 / REQ-F-003·007. 추천 당시 사용자가 입력한 상황별 조건'
}

Table recommendations {
  recommendation_id bigint [pk, increment]
  condition_id bigint [not null]
  previous_recommendation_id bigint [note: '재추천이면 직전 recommendation_id, 최초 추천이면 NULL']
  status varchar(20) [not null, note: 'PROCESSING, SUCCESS, FAILED']
  failure_code varchar(50) [note: 'FAILED 상태의 기계 판독용 코드']
  failure_message text [note: 'FAILED 상태의 사용자 안내용 메시지']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    condition_id [name: 'idx_recommendations_condition_id']
    previous_recommendation_id [name: 'idx_recommendations_previous_id']
  }


  checks {
    `status in ('PROCESSING', 'SUCCESS', 'FAILED')` [name: 'chk_recommendation_status']
    `previous_recommendation_id is null or previous_recommendation_id <> recommendation_id` [name: 'chk_recommendation_not_self']
    `status = 'FAILED' or (failure_code is null and failure_message is null)` [name: 'chk_recommendation_failure_state']
    `status <> 'FAILED' or failure_message is not null` [name: 'chk_recommendation_failure_message']
  }

  Note: 'UC7·UC8·UC10 / REQ-F-007·008·010. 조건과 분리된 AI 실행 기록. 이전 추천 연결은 같은 condition_id 안에서만 허용하고 순환 참조를 금지'
}

Table recommendation_candidates {
  candidate_id bigint [pk, increment]
  recommendation_id bigint [not null]
  gift_name varchar(255) [not null]
  gift_category varchar(100)
  estimated_price_min integer
  estimated_price_max integer
  recommendation_reason text [not null]
  considered_info text [note: '조회 편의용 불변 설명 스냅샷. 정규화된 원본 데이터나 검색 조건으로 사용하지 않음']
  caution_note text
  recommend_rank integer [not null, note: '동일 추천 결과 내 추천 순위. 1부터 시작']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    recommendation_id [name: 'idx_candidates_recommendation_id']
    (recommendation_id, recommend_rank) [unique, name: 'uq_candidate_recommend_rank']
  }

  checks {
    `estimated_price_min IS NULL OR estimated_price_min >= 0` [name: 'chk_candidate_price_min']
    `estimated_price_max IS NULL OR estimated_price_min IS NULL OR estimated_price_max >= estimated_price_min` [name: 'chk_candidate_price_range']
    `recommend_rank > 0` [name: 'chk_candidate_recommend_rank']
    `char_length(btrim(gift_name)) > 0` [name: 'chk_candidate_name_not_blank']
  }

  Note: 'UC8·UC9·UC10 / REQ-F-008·009·010. 한 번의 추천 실행에서 생성된 여러 선물 후보'
}

Table feedback {
  feedback_id bigint [pk, increment]
  candidate_id bigint [not null, unique]
  feedback_type varchar(20) [not null, note: 'LIKE, DISLIKE']
  dislike_reason varchar(255) [note: 'TASTE_MISMATCH, ALREADY_OWNED, SIMILAR_TO_PREVIOUS, TOO_BURDENSOME, NOT_PRACTICAL, PRICE_INAPPROPRIATE, WANT_DIFFERENT_STYLE, OTHER']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  checks {
    `feedback_type in ('LIKE', 'DISLIKE')` [name: 'chk_feedback_type']
    `dislike_reason is null or dislike_reason in ('TASTE_MISMATCH', 'ALREADY_OWNED', 'SIMILAR_TO_PREVIOUS', 'TOO_BURDENSOME', 'NOT_PRACTICAL', 'PRICE_INAPPROPRIATE', 'WANT_DIFFERENT_STYLE', 'OTHER')` [name: 'chk_feedback_dislike_reason']
    `(feedback_type = 'LIKE' AND dislike_reason IS NULL) OR feedback_type = 'DISLIKE'` [name: 'chk_feedback_reason']
  }

  Note: 'UC9·UC10 / REQ-F-009·010. 후보별 현재 피드백 0..1건. 변경 시 새 행 추가가 아니라 upsert'
}

Ref: users.user_id < recipient.user_id [delete: cascade, update: no action]
Ref: recipient.recipient_id < structured_preference.recipient_id [delete: cascade, update: no action]
Ref: recipient.recipient_id < previous_gifts.recipient_id [delete: cascade, update: no action]
Ref: recipient.recipient_id < gift_conditions.recipient_id [delete: cascade, update: no action]
Ref: gift_conditions.condition_id < recommendations.condition_id [delete: cascade, update: no action]
Ref: recommendations.recommendation_id < recommendation_candidates.recommendation_id [delete: cascade, update: no action]
Ref: recommendation_candidates.candidate_id - feedback.candidate_id [delete: cascade, update: no action]
Ref: recommendations.recommendation_id < recommendations.previous_recommendation_id [delete: set null, update: no action]
